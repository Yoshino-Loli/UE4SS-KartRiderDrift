diff --git a/patternsleuth/src/process/internal.rs b/patternsleuth/src/process/internal.rs
index 9ad19c4..5f59d51 100644
--- a/patternsleuth/src/process/internal.rs
+++ b/patternsleuth/src/process/internal.rs
@@ -155,6 +155,14 @@ mod windows {
         for section in object.sections() {
             let addr = (section.address() - image_base_address) as usize;
             let size = section.size() as usize;
+            // 加壳 PE 的内存头不可信：Themida 会在运行时改写节表，
+            // 导致 addr 越界。这里跳过越界节，而不是让 Rust 触发 panic 终止进程。
+            if addr
+                .checked_add(size)
+                .map_or(true, |end| end > memory.len())
+            {
+                continue;
+            }
             sections.push((section, &memory[addr..addr + size]));
         }
 
